<?php
// ============================================
// AstroNode AI — Query API
// File: as.api.query.php
// ============================================
header('Content-Type: application/json');
header('Access-Control-Allow-Origin: *');
require_once 'C:/xampp/htdocs/as/config.php';
require_once 'C:/xampp/htdocs/as/includes.db.php';
require_once 'C:/xampp/htdocs/as/includes.nasa_data.php';


$query = trim($_POST['query'] ?? '');

if (!$query) {
    echo json_encode([
        'error'      => 'Query is required.',
        'ai_response'=> 'Please enter a search query.',
        'count'      => 0
    ]);
    exit;
}

// Log query
try {
    $db = getDB();
    $db->prepare('INSERT INTO query_logs (query_text) VALUES (?)')
       ->execute([$query]);
} catch (Exception $e) {}

// Get DB data
$data = routeQuery($query);

// Get AI response
$data['ai_response'] = getWatsonxResponse($query, $data);

echo json_encode($data);

// ============================================
function getWatsonxResponse(string $query, array $dbData): string {
    $token = getIBMToken();
    if (!$token) return getFallbackResponse($query, $dbData);

    $prompt = "<|system|>
You are AstroNode AI, an expert astronomical assistant.
Answer in 2-3 clear sentences. Mention JWST, Kepler, TESS, Gaia when relevant.
<|user|>
Query: \"{$query}\"
Database: {$dbData['count']} results from {$dbData['source']}.
<|assistant|>
";

    $payload = json_encode([
        'model_id'   => IBM_MODEL,
        'input'      => $prompt,
        'parameters' => [
            'decoding_method' => 'greedy',
            'max_new_tokens'  => 180,
            'min_new_tokens'  => 30,
            'temperature'     => 0.7,
            'stop_sequences'  => ['<|user|>', '<|system|>'],
        ],
        'project_id' => IBM_PROJECT_ID,
    ]);

    $ch = curl_init(IBM_URL . '/ml/v1/text/generation?version=2023-05-29');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $payload,
        CURLOPT_HTTPHEADER     => [
            'Content-Type: application/json',
            'Authorization: Bearer ' . $token,
        ],
        CURLOPT_TIMEOUT        => 20,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);
    $res  = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($code !== 200) return getFallbackResponse($query, $dbData);

    $json = json_decode($res, true);
    $text = trim($json['results'][0]['generated_text'] ?? '');
    $text = str_replace(['<|assistant|>','<|user|>','<|system|>'], '', $text);
    return trim($text) ?: getFallbackResponse($query, $dbData);
}

function getIBMToken(): ?string {
    if (IBM_API_KEY === 'your-ibm-api-key-here') return null;
    $ch = curl_init('https://iam.cloud.ibm.com/identity/token');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => http_build_query([
            'grant_type' => 'urn:ibm:params:oauth:grant-type:apikey',
            'apikey'     => IBM_API_KEY,
        ]),
        CURLOPT_HTTPHEADER     => ['Content-Type: application/x-www-form-urlencoded'],
        CURLOPT_TIMEOUT        => 10,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);
    $res  = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    if ($code !== 200) return null;
    return json_decode($res, true)['access_token'] ?? null;
}

function getFallbackResponse(string $query, array $data): string {
    $q     = strtolower($query);
    $count = $data['count'];

    if (str_contains($q, 'planet') || str_contains($q, 'exoplanet') || str_contains($q, 'habitable')) {
        return "Found {$count} exoplanets matching your query from the NASA Exoplanet Archive. " .
               "K2-18b stands out with JWST-confirmed water vapor and a potential biosignature detected in 2023. " .
               "The TRAPPIST-1 system remains the most promising multi-planet habitable zone candidate.";
    }
    if (str_contains($q, 'star') || str_contains($q, 'closest') || str_contains($q, 'nearest')) {
        return "Retrieved {$count} nearby stars from Hipparcos and Gaia DR3 catalogs. " .
               "Proxima Centauri at 4.24 light years is our closest stellar neighbor. " .
               "Gaia has refined distances to over 1.5 billion stars with unprecedented precision.";
    }
    if (str_contains($q, 'supernova') || str_contains($q, 'remnant')) {
        return "Supernova remnants are among the most energetic phenomena in the universe. " .
               "JWST's 2023 imaging of SN 1987A revealed the neutron star at its core for the first time. " .
               "Cassiopeia A remains the most studied young supernova remnant.";
    }
    return "Your query returned {$count} astronomical objects from {$data['source']}. " .
           "Data sourced from NASA and ESA peer-reviewed catalogs. " .
           "Add IBM watsonx.ai API key in config.php for AI-powered analysis.";
}
