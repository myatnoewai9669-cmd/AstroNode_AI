<?php
// ============================================
// AstroNode AI — Chat API (Agentic)
// File: api.chat.php
// ============================================
session_start();
header('Content-Type: application/json');
require_once 'C:/xampp/htdocs/as/config.php';
require_once 'C:/xampp/htdocs/as/includes.db.php';
require_once 'C:/xampp/htdocs/as/includes.nasa_data.php';

$message = trim($_POST['message'] ?? '');
if (!$message) {
    echo json_encode(['reply' => 'Please enter a message.']);
    exit;
}

// Init history
if (!isset($_SESSION['chat_history'])) {
    $_SESSION['chat_history'] = [];
}

// --- Check if query needs DB data ---
$dbContext = '';
$dbData    = null;
$keywords  = ['planet','exoplanet','star','habitable','jwst','kepler','tess','atmosphere','supernova','gaia','trappist','proxima'];
$needsDB   = false;
foreach ($keywords as $kw) {
    if (stripos($message, $kw) !== false) { $needsDB = true; break; }
}
if ($needsDB) {
    $dbData   = routeQuery(strtolower($message));
    $dbContext = "Database returned {$dbData['count']} results from {$dbData['source']}.";
}

// --- Build conversation history for IBM ---
$systemPrompt = "You are AstroNode AI, an expert astronomical research copilot powered by IBM Granite.
You have deep knowledge of NASA/ESA missions, exoplanets, stellar physics, and space exploration.
Answer concisely (3-4 sentences max). Be scientifically accurate but accessible.
When referencing database results, mention specific planet/star names.
Remember the full conversation context for follow-up questions.";

$ibmMessages = [];
foreach ($_SESSION['chat_history'] as $h) {
    $ibmMessages[] = ['role' => $h['role'], 'content' => $h['content']];
}

$userContent = $message;
if ($dbContext) $userContent .= "\n\nDatabase context: " . $dbContext;

$ibmMessages[] = ['role' => 'user', 'content' => $userContent];

// --- Call IBM watsonx.ai ---
$reply   = '';
$context = $dbContext ? "Using {$dbData['source']}" : 'General knowledge';

$token = getIBMToken();
if ($token) {
    // Build prompt from history
    $prompt = "<|system|>\n{$systemPrompt}\n";
    foreach ($ibmMessages as $m) {
        $role = $m['role'] === 'user' ? '<|user|>' : '<|assistant|>';
        $prompt .= "{$role}\n{$m['content']}\n";
    }
    $prompt .= "<|assistant|>\n";

    $payload = json_encode([
        'model_id'   => IBM_MODEL,
        'input'      => $prompt,
        'parameters' => [
            'decoding_method' => 'greedy',
            'max_new_tokens'  => 220,
            'min_new_tokens'  => 20,
            'temperature'     => 0.75,
            'stop_sequences'  => ['<|user|>', '<|system|>'],
        ],
        'project_id' => IBM_PROJECT_ID,
    ]);

    $ch = curl_init(IBM_URL . '/ml/v1/text/generation?version=2023-05-29');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $payload,
        CURLOPT_HTTPHEADER     => [
            'Content-Type: application/json',
            'Authorization: Bearer ' . $token,
        ],
        CURLOPT_TIMEOUT        => 20,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);
    $res  = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($code === 200) {
        $json  = json_decode($res, true);
        $reply = trim($json['results'][0]['generated_text'] ?? '');
        $reply = str_replace(['<|assistant|>','<|user|>','<|system|>'], '', $reply);
        $reply = trim($reply);
    }
}

// --- Fallback ---
if (!$reply) {
    $reply = getFallbackChat($message, $dbData);
    $context = 'Local knowledge';
}

// --- Save to session history ---
$_SESSION['chat_history'][] = [
    'role'    => 'user',
    'content' => $message,
    'time'    => date('H:i'),
];
$_SESSION['chat_history'][] = [
    'role'    => 'assistant',
    'content' => $reply,
    'context' => $context,
    'time'    => date('H:i'),
];

// Keep last 20 messages only
if (count($_SESSION['chat_history']) > 20) {
    $_SESSION['chat_history'] = array_slice($_SESSION['chat_history'], -20);
}

echo json_encode(['reply' => $reply, 'context' => $context]);


// ============================================
function getIBMToken(): ?string {
    if (IBM_API_KEY === 'your api key') return null;
    $ch = curl_init('https://iam.cloud.ibm.com/identity/token');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => http_build_query([
            'grant_type' => 'urn:ibm:params:oauth:grant-type:apikey',
            'apikey'     => IBM_API_KEY,
        ]),
        CURLOPT_HTTPHEADER     => ['Content-Type: application/x-www-form-urlencoded'],
        CURLOPT_TIMEOUT        => 10,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);
    $res  = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    if ($code !== 200) return null;
    return json_decode($res, true)['access_token'] ?? null;
}

function getFallbackChat(string $msg, ?array $db): string {
    $q = strtolower($msg);

    if (str_contains($q, 'most promising') || str_contains($q, 'best candidate')) {
        return "Based on current data, TRAPPIST-1e and GJ 12b are the most promising candidates for life. TRAPPIST-1e sits firmly in the habitable zone with a near-Earth radius, while GJ 12b discovered in 2024 orbits a quiet M-dwarf just 40 light years away. K2-18b remains notable for its JWST-confirmed water vapor and potential biosignatures.";
    }
    if (str_contains($q, 'trappist')) {
        return "The TRAPPIST-1 system hosts 7 Earth-sized planets orbiting an ultra-cool dwarf star 39 light years away. Three planets — e, f, and g — lie in the habitable zone. JWST has been actively studying their atmospheres, with early results suggesting TRAPPIST-1c has little to no thick CO₂ atmosphere.";
    }
    if (str_contains($q, 'jwst') || str_contains($q, 'james webb')) {
        return "JWST has transformed exoplanet science since 2022. Key discoveries include confirmed water vapor on K2-18b, a possible biosignature (dimethyl sulfide), and detailed atmospheric maps of hot Jupiters. JWST's NIRSpec instrument can detect molecules like CO₂, CH₄, and H₂O in exoplanet atmospheres with unprecedented precision.";
    }
    if (str_contains($q, 'habitable zone') || str_contains($q, 'goldilocks')) {
        return "The habitable zone is the range of orbital distances where liquid water could exist on a planet's surface — often called the Goldilocks zone. For Sun-like stars, this spans roughly 0.95–1.37 AU. For cooler M-dwarfs like TRAPPIST-1, the zone is much closer. Temperature, atmospheric pressure, and stellar radiation all affect actual habitability.";
    }
    if (str_contains($q, 'atmosphere') || str_contains($q, 'detect')) {
        return "Astronomers detect exoplanet atmospheres using transmission spectroscopy — measuring starlight filtered through a planet's atmosphere during transit. Different molecules absorb specific wavelengths, creating a chemical fingerprint. JWST's sensitivity allows detection of water, carbon dioxide, methane, and even potential biosignatures at distances of hundreds of light years.";
    }
    if ($db && $db['count'] > 0) {
        return "I found {$db['count']} results from {$db['source']} related to your question. " .
               "Feel free to ask follow-up questions like 'Which one is most Earth-like?' or 'Explain the most interesting result' and I'll analyze the data further.";
    }
    return "That's a fascinating astronomical question! Based on current NASA and ESA data, our understanding of the cosmos continues to evolve rapidly. JWST, Gaia DR3, and TESS are generating unprecedented data. Could you be more specific about which aspect you'd like to explore — exoplanets, stellar physics, or cosmology?";
}
